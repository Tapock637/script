local function StartAutoFarmFruit()
    if State.AutoFarmFruitEnabled and AutoFarmFruitThread then return true end

    if not IsTeamSelected() then
        selectTeam(CONFIG.Team)
        task.wait(2.5)
        if not IsTeamSelected() then return false end
    end

    State.AutoFarmFruitEnabled = true

    AutoFlyConn = RunService.Heartbeat:Connect(function(dt)
        if not State.AutoFarmFruitEnabled then return end
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local target = GetNearestFruit()
        if not target then
            DisableNoclip()
            local bv = hrp:FindFirstChildOfClass("BodyVelocity")
            if bv then bv:Destroy() end
            return
        end
        if char.HumanoidRootPart.CollisionGroup ~= NOCLIP_GROUP then EnableNoclip() end
        if not hrp:FindFirstChildOfClass("BodyVelocity") then
            local bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bv.Velocity = Vector3.new(0, 0, 0)
            bv.Parent = hrp
        end
        local bv = hrp:FindFirstChildOfClass("BodyVelocity")
        local dir = target.Position - hrp.Position
        if dir.Magnitude <= CONFIG.ReachDistance then bv.Velocity = Vector3.new(0, 0, 0); return end
        bv.Velocity = dir.Unit * CONFIG.FlySpeed
    end)

    AutoFarmFruitThread = task.spawn(function()
        local emptyTimer = 0
        local lastCheck = tick()
        while State.AutoFarmFruitEnabled do
            task.wait(0.5)
            local now = tick()
            local dt = now - lastCheck
            lastCheck = now
            for inst, data in pairs(Tracked) do
                if not inst.Parent or not data.Adornee or not data.Adornee.Parent then RemoveFruit(inst) end
            end
            if HasAnyFruit() then
                emptyTimer = 0
            else
                emptyTimer = emptyTimer + dt
                if emptyTimer >= CONFIG.FruitLostDelay then
                    TryStoreFruit()
                    task.wait(CONFIG.ServerHopDelay)
                    ServerHop()
                    return
                end
            end
        end
    end)

    return true
end

local function GetClosestPlayer()
    local myPos = GetMyPosition()
    if not myPos then return nil end
    local closest, closestDist = nil, math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if hrp and player.Team ~= LocalPlayer.Team then
                local dist = (hrp.Position - myPos).Magnitude
                if dist < closestDist and dist <= 50 then
                    closestDist = dist
                    closest = player
                end
            end
        end
    end
    return closest
end


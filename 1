end)

local dragging = false
local dragStart, startPos

toggleBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = toggleBtn.Position
    end
end)

toggleBtn.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        toggleBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

local menuDragging = false
local menuDragStart, menuStartPos

title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        menuDragging = true
        menuDragStart = input.Position
        menuStartPos = mainFrame.Position
    end
end)

title.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        menuDragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if menuDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - menuDragStart
        mainFrame.Position = UDim2.new(menuStartPos.X.Scale, menuStartPos.X.Offset + delta.X, menuStartPos.Y.Scale, menuStartPos.Y.Offset + delta.Y)
    end
end)

ScanFruits()

task.spawn(function()
    while task.wait(CONFIG.ScanInterval) do
        ScanFruits()
    end
end)

Workspace.DescendantAdded:Connect(function(inst)
    if inst:IsA("Tool") or inst:IsA("Model") then
        task.defer(TryTrackFruit, inst)
    end
end)

Workspace.DescendantRemoving:Connect(function(inst)
    if Tracked[inst] then
        RemoveFruit(inst)
    end
end)

for _, player in ipairs(Players:GetPlayers()) do
    ApplyPlayerESP(player, player == LocalPlayer)
end

Players.PlayerAdded:Connect(function(player)
    ApplyPlayerESP(player, false)
end)

Players.PlayerRemoving:Connect(function(player)
    local data = PlayerESP[player]
    if data then
        if data.Gui then data.Gui:Destroy() end
        if data.Highlight then data.Highlight:Destroy() end
        PlayerESP[player] = nil
    end
end)

RunService.RenderStepped:Connect(function()
    local myPos = GetMyPosition()
    if not myPos then return end

    for inst, data in pairs(Tracked) do
        if not inst.Parent or not data.Adornee or not data.Adornee.Parent then
            RemoveFruit(inst)
            continue
        end

        local dist = (data.Adornee.Position - myPos).Magnitude

        if CONFIG.MinDistance > 0 and dist < CONFIG.MinDistance then
            data.Gui.Enabled = false
            if data.Highlight then data.Highlight.Enabled = false end
        elseif CONFIG.MaxDistance > 0 and dist > CONFIG.MaxDistance then
            data.Gui.Enabled = false
            if data.Highlight then data.Highlight.Enabled = false end
        else
            if State.ShowFruits then
                data.Gui.Enabled = true
                if data.Highlight then data.Highlight.Enabled = true end
                if CONFIG.ShowDistance then
                    data.Label.Text = string.format("%s\n[%d studs]", data.Name, math.floor(dist))
                else
                    data.Label.Text = data.Name
                end
            else
                data.Gui.Enabled = false
                if data.Highlight then data.Highlight.Enabled = false end
            end
        end
    end

    for player, data in pairs(PlayerESP) do
        if not data.Head or not data.Head.Parent then
            if data.Gui then data.Gui:Destroy() end
            if data.Highlight then data.Highlight:Destroy() end
            PlayerESP[player] = nil
            continue
        end

        local dist = (data.Head.Position - myPos).Magnitude

        if CONFIG.MinDistance > 0 and dist < CONFIG.MinDistance then
            data.Gui.Enabled = false
            if data.Highlight then data.Highlight.Enabled = false end
        elseif CONFIG.MaxDistance > 0 and dist > CONFIG.MaxDistance then
            data.Gui.Enabled = false
            if data.Highlight then data.Highlight.Enabled = false end
        else
            if State.ShowPlayers then
                data.Gui.Enabled = true
                if data.Highlight then data.Highlight.Enabled = true end
                if CONFIG.ShowDistance then
                    data.Label.Text = string.format("%s\n[%d studs]", data.BaseText, math.floor(dist))
                else
                    data.Label.Text = data.BaseText
                end
            else
                data.Gui.Enabled = false
                if data.Highlight then data.Highlight.Enabled = false end
            end
        end
    end
end)

task.spawn(function()
    task.wait(0.5)
    local found = false
    for _ in pairs(Tracked) do
        found = true
        break
    end
    if found then
        notify("FRUIT FOUND", CONFIG.FruitColor)
    else
        notify("NO FRUIT FOUND", Color3.fromRGB(255, 160, 60))
    end
end)

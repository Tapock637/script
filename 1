local function StopFly()
    FlyActive = false
    if FlyConnection then
        FlyConnection:Disconnect()
        FlyConnection = nil
    end
end

local function StartFly()
    if FlyActive then return end

    local char = LocalPlayer.Character
    if not char then return end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local target = GetNearestFruit()
    if not target then
        notify("NO FRUIT FOUND", Color3.fromRGB(255, 160, 60))
        return
    end

    FlyActive = true
    local speed = 100
    local reachDist = 3

    FlyConnection = RunService.Heartbeat:Connect(function(dt)
        if not FlyActive then
            if FlyConnection then FlyConnection:Disconnect() end
            return
        end

        local c = LocalPlayer.Character
        if not c then StopFly() return end

        local currentHrp = c:FindFirstChild("HumanoidRootPart")
        if not currentHrp then StopFly() return end

        if not target.Parent then
            target = GetNearestFruit()
            if not target then
                StopFly()
                notify("TARGET LOST", Color3.fromRGB(255, 160, 60))
                return
            end
        end

        local targetPos = target.Position
        local myPos = currentHrp.Position
        local dir = (targetPos - myPos)

        if dir.Magnitude <= reachDist then
            StopFly()
            notify("ARRIVED", Color3.fromRGB(100, 255, 120))
            return
        end

        dir = dir.Unit
        local move = dir * speed * dt
        currentHrp.CFrame = currentHrp.CFrame + move
        currentHrp.Velocity = Vector3.new(0, 0, 0)
    end)
end

local function StopRun()
    RunActive = false
    if RunConnection then
        RunConnection:Disconnect()
        RunConnection = nil
    end
end

local function StartRun()
    if RunActive then return end

    local char = LocalPlayer.Character
    if not char then return end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    local target = GetNearestFruit()
    if not target then
        notify("NO FRUIT FOUND", Color3.fromRGB(255, 160, 60))
        return
    end

    RunActive = true
    local lastJump = 0
    local jumpSpam = false
    local spamUntil = 0

    RunConnection = RunService.Heartbeat:Connect(function(dt)
        if not RunActive then
            if RunConnection then RunConnection:Disconnect() end
            return
        end

        local c = LocalPlayer.Character
        if not c then return end

        local currentHrp = c:FindFirstChild("HumanoidRootPart")
        local currentHum = c:FindFirstChildOfClass("Humanoid")
        if not currentHrp or not currentHum then return end

        local t = GetNearestFruit()
        if not t then
            StopRun()
            notify("NO FRUIT FOUND", Color3.fromRGB(255, 160, 60))
            return
        end

        local targetPos = t.Position
        local myPos = currentHrp.Position
        local dir = (targetPos - myPos)

        if dir.Magnitude <= 4 then
            StopRun()
            notify("ARRIVED", Color3.fromRGB(100, 255, 120))
            return
        end

        local now = tick()
        local currentHealth = currentHum.Health
        if currentHum:GetAttribute("LastHealth") then
            local lastHealth = currentHum:GetAttribute("LastHealth")
            if currentHealth < lastHealth then
                jumpSpam = true
                spamUntil = now + 1.5
            end
        end
        currentHum:SetAttribute("LastHealth", currentHealth)

        local flatDir = Vector3.new(dir.X, 0, dir.Z)
        if flatDir.Magnitude > 0 then
            flatDir = flatDir.Unit
            local move = flatDir * currentHum.WalkSpeed * dt
            currentHrp.CFrame = currentHrp.CFrame + move
        end

        local rayOrigin = currentHrp.Position
        local rayDir = flatDir * 5
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = {c}

        local rayResult = workspace:Raycast(rayOrigin, rayDir, rayParams)
        local wallBlocked = rayResult ~= nil

        local downRay = workspace:Raycast(rayOrigin, Vector3.new(0, -10, 0), rayParams)
        local voidAhead = downRay == nil

        local shouldJump = false

        if wallBlocked then shouldJump = true end
        if voidAhead and (now - lastJump >= 1) then shouldJump = true end
        if jumpSpam and now < spamUntil then shouldJump = true else jumpSpam = false end

        if shouldJump then
            currentHum.Jump = true
            lastJump = now
        end
    end)
end

local function StopCafeWalk()
    CafeWalkActive = false
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum:MoveTo(char.HumanoidRootPart.Position)
        end
    end
    if CafeConnection then
        CafeConnection:Disconnect()
        CafeConnection = nil
    end
end

local function StartCafeWalk()
    if CafeWalkActive then return end

    local char = LocalPlayer.Character
    if not char then return end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    local cafePart = FindCafePosition()
    if not cafePart then
        notify("CAFE NOT FOUND", Color3.fromRGB(255, 160, 60))
        return
    end

    CafeWalkActive = true
    local lastJump = 0

    CafeConnection = RunService.Heartbeat:Connect(function(dt)
        if not CafeWalkActive then
            if CafeConnection then CafeConnection:Disconnect() end
            return
        end

        local c = LocalPlayer.Character
        if not c then StopCafeWalk() return end

        local currentHrp = c:FindFirstChild("HumanoidRootPart")
        local currentHum = c:FindFirstChildOfClass("Humanoid")
        if not currentHrp or not currentHum then StopCafeWalk() return end

        if not cafePart or not cafePart.Parent then
            cafePart = FindCafePosition()
            if not cafePart then
                StopCafeWalk()
                notify("CAFE LOST", Color3.fromRGB(255, 160, 60))
                return
            end
        end

        local targetPos = cafePart.Position
        local myPos = currentHrp.Position
        local dir = (targetPos - myPos)

        if dir.Magnitude <= 6 then
            StopCafeWalk()
            notify("ARRIVED AT CAFE", Color3.fromRGB(100, 255, 120))
            return
        end

        local now = tick()
        local flatDir = Vector3.new(dir.X, 0, dir.Z)

        if flatDir.Magnitude > 0 then
            flatDir = flatDir.Unit
            local move = flatDir * currentHum.WalkSpeed * dt
            currentHrp.CFrame = currentHrp.CFrame + move
        end

        local rayOrigin = currentHrp.Position
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = {c}

        local downRay = workspace:Raycast(rayOrigin, Vector3.new(0, -10, 0), rayParams)
        local voidAhead = downRay == nil

        local shouldJump = false

        if voidAhead and (now - lastJump >= 1) then
            shouldJump = true
        end

        if shouldJump then
            currentHum.Jump = true
            lastJump = now
        end
    end)
end


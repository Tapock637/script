local function StopAutoFruit()
    AutoFruitActive = false
    if AutoThread then
        task.cancel(AutoThread)
        AutoThread = nil
    end
    StopFly()
end

local function StartAutoFruit()
    if AutoFruitActive then return true end

    -- Проверка команды
    if not IsTeamSelected() then
        notify("Selecting team " .. CONFIG.Team .. "...", Color3.fromRGB(255, 200, 100))
        local ok = selectTeam()
        if not ok then
            notify("Failed to select team. Abort.", Color3.fromRGB(255, 100, 100))
            return false
        end
        task.wait(2)
        if not IsTeamSelected() then
            notify("Team not selected. Abort.", Color3.fromRGB(255, 100, 100))
            return false
        end
        notify("Team selected!", Color3.fromRGB(100, 255, 120))
    end

    AutoFruitActive = true
    notify("Auto Fruit Started", Color3.fromRGB(100, 255, 120))

    AutoThread = task.spawn(function()
        local noFruitTimer = 0
        local lastCheck = tick()
        local notifiedWaiting = false

        while AutoFruitActive do
            local success, err = pcall(function()
                task.wait(0.5)

                local now = tick()
                local dt = now - lastCheck
                lastCheck = now

                if HasAnyFruit() then
                    noFruitTimer = 0
                    notifiedWaiting = false

                    if not FlyActive then
                        local fruit = GetNearestFruit()
                        if fruit then
                            StartFly()
                        end
                    end
                else
                    noFruitTimer = noFruitTimer + dt

                    if not notifiedWaiting and noFruitTimer > 1 then
                        notify("Waiting for fruit...", Color3.fromRGB(255, 200, 100))
                        notifiedWaiting = true
                    end

                    if noFruitTimer >= CONFIG.FruitLostDelay then
                        if FlyActive then
                            StopFly()
                        end
                        notify("Fruit lost. Storing + hopping...", Color3.fromRGB(255, 160, 60))
                        TryStoreFruit()
                        task.wait(CONFIG.ServerHopDelay)
                        ServerHop()
                        return
                    end
                end
            end)

            if not success then
                notify("Auto Fruit Error: " .. tostring(err), Color3.fromRGB(255, 100, 100))
                task.wait(1)
            end
        end
    end)

    return true
end


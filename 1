local function StartAutoStore()
    if AutoStoreThread then return end
    AutoStoreThread = task.spawn(function()
        while AutoStoreEnabled do
            task.wait(0.5)
            local tool = FindFruitTool()
            if tool then TryStoreFruit() end
            local char = LocalPlayer.Character
            local backpack = LocalPlayer:FindFirstChild("Backpack")
            if char and backpack then
                for _, child in ipairs(char:GetChildren()) do
                    if child:IsA("Tool") and not IsFruitName(child.Name) then
                        pcall(function() child.Parent = backpack end)
                    end
                end
            end
        end
    end)
end

local function StopAutoStore()
    AutoStoreEnabled = false
    if AutoStoreThread then task.cancel(AutoStoreThread); AutoStoreThread = nil end
end

local function UpdateScale()

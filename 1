local function TryTrackFruit(inst)
    if Tracked[inst] then return end
    if not IsFruitRelated(inst) then return end
    local adornee = GetAdornee(inst)
    if not adornee then return end
    local bb, label = CreateFruitBillboard(adornee, inst.Name, CONFIG.FruitColor)
    local hl = CreateFruitOutline(adornee, CONFIG.FruitColor)
    Tracked[inst] = { Gui = bb, Label = label, Highlight = hl, Adornee = adornee, Name = inst.Name }
    if not ESPEnabled then bb.Enabled = false; hl.Enabled = false end
end

local function RemoveFruitTracked(inst)
    local d = Tracked[inst]
    if not d then return end
    if d.Gui then d.Gui:Destroy() end
    if d.Highlight then d.Highlight:Destroy() end
    Tracked[inst] = nil
end

local function ScanFruits()
    for _, inst in ipairs(Workspace:GetDescendants()) do
        if inst:IsA("Tool") or inst:IsA("Model") then TryTrackFruit(inst) end
    end
end

local function GetMyPosition()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then return char.HumanoidRootPart.Position end
    return nil
end

local function GetNearestFruit()
    local myPos = GetMyPosition()
    if not myPos then return nil end
    local nearest, nearestDist = nil, math.huge
    for inst, data in pairs(Tracked) do
        if inst.Parent and data.Adornee and data.Adornee.Parent then
            local dist = (data.Adornee.Position - myPos).Magnitude
            if dist < nearestDist then nearestDist = dist; nearest = data.Adornee end
        end
    end
    return nearest
end

local function FindFruitTool()
    local char = LocalPlayer.Character
    if not char then return nil end
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") and IsFruitName(child.Name) and not HasExcluded(child.Name) then return child end
    end
    if backpack then
        for _, child in ipairs(backpack:GetChildren()) do
            if child:IsA("Tool") and IsFruitName(child.Name) and not HasExcluded(child.Name) then return child end
        end
    end
    return nil
end

local function GetFruitCode(toolName)
    local cleanName = StripSuffix(toolName)
    if FRUIT_CODES[cleanName] then return FRUIT_CODES[cleanName] end
    local base = cleanName:gsub(" Fruit", "")
    if FRUIT_CODES[base .. " Fruit"] then return FRUIT_CODES[base .. " Fruit"] end
    return base .. "-" .. base
end

local function TryStoreFruit()
    local tool = FindFruitTool()
    if not tool then return false end
    local commF = GetCommF()
    if not commF then return false end
    local code = GetFruitCode(tool.Name)
    local attempts = { {code, tool}, {code, tool.Name}, {tool.Name, tool}, {tool.Name}, {code} }
    for _, args in ipairs(attempts) do
        local ok = pcall(function() return commF:InvokeServer("StoreFruit", unpack(args)) end)
        if ok then task.wait(0.3); if not tool.Parent then return true end end
    end
    return false
end

local function StartFlyToFruit()
    if FlyConn then FlyConn:Disconnect(); FlyConn = nil end
    FlyConn = RunService.Heartbeat:Connect(function(dt)
        if not FlyEnabled then return end
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local target = GetNearestFruit()
        if not target then
            DisableNoclip()
            local bv = hrp:FindFirstChildOfClass("BodyVelocity")
            if bv then bv:Destroy() end
            return
        end
        if char.HumanoidRootPart.CollisionGroup ~= NOCLIP_GROUP then EnableNoclip() end
        if not hrp:FindFirstChildOfClass("BodyVelocity") then
            local bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bv.Velocity = Vector3.new(0, 0, 0)
            bv.Parent = hrp
        end
        local bv = hrp:FindFirstChildOfClass("BodyVelocity")
        local dir = target.Position - hrp.Position
        if dir.Magnitude <= CONFIG.ReachDistance then bv.Velocity = Vector3.new(0, 0, 0); return end
        bv.Velocity = dir.Unit * CONFIG.FlySpeed
    end)
end

local function StopFlyToFruit()
    if FlyConn then FlyConn:Disconnect(); FlyConn = nil end
    DisableNoclip()
    local char = LocalPlayer.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then local bv = hrp:FindFirstChildOfClass("BodyVelocity"); if bv then bv:Destroy() end end
    end
end

local function StartAutoFarmFruit()
    if AutoFarmFruitThread then return end
    AutoFarmFruitThread = task.spawn(function()
        local emptyTimer = 0
        local lastCheck = tick()
        while AutoFarmFruitEnabled do
            task.wait(0.5)
            local now = tick()
            local dt = now - lastCheck
            lastCheck = now
            for inst, data in pairs(Tracked) do
                if not inst.Parent or not data.Adornee or not data.Adornee.Parent then RemoveFruitTracked(inst) end
            end
            local target = GetNearestFruit()
            if target then
                emptyTimer = 0
                if not FlyEnabled then FlyEnabled = true; StartFlyToFruit() end
                task.wait(0.3)
                TryStoreFruit()
            else
                emptyTimer = emptyTimer + dt
                if emptyTimer >= CONFIG.FruitLostDelay then
                    if FlyEnabled then FlyEnabled = false; StopFlyToFruit() end
                    TryStoreFruit()
                    task.wait(CONFIG.ServerHopDelay)
                    pcall(function()
                        local url = "https://games.roproxy.com/v1/games/" .. CONFIG.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100&excludeFullGames=true"
                        local response = game:HttpGet(url)
                        local data = HttpService:JSONDecode(response)
                        local servers = {}
                        for _, s in ipairs(data.data or {}) do
                            if s.id ~= game.JobId and s.playing < s.maxPlayers then table.insert(servers, s.id) end
                        end
                        if #servers > 0 then
                            TeleportService:TeleportToPlaceInstance(CONFIG.PlaceId, servers[math.random(1, #servers)], LocalPlayer)
                        end
                    end)
                    return
                end
            end
        end
    end)
end

local function StopAutoFarmFruit()
    AutoFarmFruitEnabled = false
    if AutoFarmFruitThread then task.cancel(AutoFarmFruitThread); AutoFarmFruitThread = nil end
    if FlyEnabled then FlyEnabled = false; StopFlyToFruit() end
end

local AimbotTarget = nil
local SkillKeys = { "Z", "X", "C", "V", "F" }

local function GetClosestTarget()
    local myPos = GetMyPosition()
    if not myPos then return nil end
    local closest, closestDist = nil, math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if hrp and player.Team ~= LocalPlayer.Team then
                local dist = (hrp.Position - myPos).Magnitude
                if dist < closestDist then closestDist = dist; closest = player end
            end
        end
    end
    return closest
end

local function StartAimbot()
    if AimbotConn then AimbotConn:Disconnect(); AimbotConn = nil end
    AimbotConn = RunService.RenderStepped:Connect(function()
        if not AimbotEnabled then return end
        local target = GetClosestTarget()
        if not target or not target.Character then return end
        local targetHead = target.Character:FindFirstChild("Head")
        if not targetHead then return end
        local camera = Workspace.CurrentCamera
        camera.CFrame = CFrame.new(camera.CFrame.Position, targetHead.Position)
        AimbotTarget = target
    end)
    task.spawn(function()
        while AimbotEnabled do
            task.wait(0.1)
            if AimbotTarget and AimbotTarget.Character then
                for _, key in ipairs(SkillKeys) do
                    pcall(function()
                        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode[key], false, game)
                        task.wait(0.05)
                        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[key], false, game)
                    end)
                end
            end
        end
    end)
end

local function StopAimbot()
    if AimbotConn then AimbotConn:Disconnect(); AimbotConn = nil end
    AimbotTarget = nil
end

local function FindBoss()
    local myPos = GetMyPosition()
    if not myPos then return nil end
    local nearest, nearestDist = nil, math.huge
    for _, inst in ipairs(Workspace:GetDescendants()) do
        if inst:IsA("Model") and inst:FindFirstChild("Humanoid") then
            local name = inst.Name:lower()
            for _, bossName in ipairs(BOSS_LIST) do
                if name:find(bossName:lower(), 1, true) then
                    local hrp = inst:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local dist = (hrp.Position - myPos).Magnitude
                        if dist < nearestDist then nearestDist = dist; nearest = hrp end
                    end
                end
            end
        end
    end
    return nearest
end

local function StartAutoBossFarm()
    if AutoBossFarmThread then return end
    AutoBossFarmThread = task.spawn(function()
        while AutoBossFarmEnabled do
            task.wait(0.5)
            local boss = FindBoss()
            if boss then
                EnableNoclip()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    if not hrp:FindFirstChildOfClass("BodyVelocity") then
                        local bv = Instance.new("BodyVelocity")
                        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                        bv.Parent = hrp
                    end
                    local bv = hrp:FindFirstChildOfClass("BodyVelocity")
                    local dir = boss.Position - hrp.Position
                    if dir.Magnitude > 5 then
                        bv.Velocity = dir.Unit * CONFIG.FlySpeed
                    else
                        bv.Velocity = Vector3.new(0, 0, 0)
                        for _, key in ipairs(SkillKeys) do
                            pcall(function()
                                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode[key], false, game)
                                task.wait(0.05)
                                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[key], false, game)
                            end)
                        end
                    end
                end
            else
                DisableNoclip()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local bv = hrp:FindFirstChildOfClass("BodyVelocity")
                    if bv then bv:Destroy() end
                end
            end
        end
    end)
end


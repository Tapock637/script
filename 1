-- ================= SERVER HOP =================
local function ServerHop()
    local servers = {}
    local success, response = pcall(function()
        return game:HttpGet(
            "https://games.roproxy.com/v1/games/" .. CONFIG.PlaceId ..
            "/servers/Public?sortOrder=Asc&limit=100&excludeFullGames=true"
        )
    end)

    if success and response then
        local ok, data = pcall(function()
            return HttpService:JSONDecode(response)
        end)
        if ok and data and data.data then
            for _, server in ipairs(data.data) do
                if server.id ~= game.JobId and server.playing < CONFIG.MaxPlayersForHop then
                    table.insert(servers, server.id)
                end
            end
        end
    end

    if #servers > 0 then
        local randomServer = servers[math.random(1, #servers)]
        pcall(function()
            TeleportService:TeleportToPlaceInstance(CONFIG.PlaceId, randomServer, LocalPlayer)
        end)
    else
        pcall(function()
            TeleportService:Teleport(CONFIG.PlaceId, LocalPlayer)
        end)
    end
end

        isListening = true
        WaitingForKey = true
        Btn.Text = text .. ": нажми клавишу..."
        Btn.TextColor3 = Color3.fromRGB(255, 200, 100)
    end)
    UserInputService.InputBegan:Connect(function(input, gameProcessed)

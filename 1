local function updateButtonVisual(btn, stroke, enabled, color)
    if enabled then
        btn.TextColor3 = color
        btn.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
        TweenService:Create(stroke, TweenInfo.new(0.25), {Transparency = 0.2}):Play()
    else
        btn.TextColor3 = Color3.fromRGB(140, 140, 140)
        btn.BackgroundColor3 = Color3.fromRGB(30, 30, 36)
        TweenService:Create(stroke, TweenInfo.new(0.25), {Transparency = 1}):Play()
    end
end

local function refreshButton(btn, stroke, text, enabled, color)
    updateButtonVisual(btn, stroke, enabled, color)
    btn.Text = (enabled and "●  " or "○  ") .. text
end


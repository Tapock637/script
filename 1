local function SetCharacterCollisionGroup(group)
    local char = LocalPlayer.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then part.CollisionGroup = group end
    end
end

local function EnableNoclip() SetCharacterCollisionGroup(NOCLIP_GROUP) end
local function DisableNoclip() SetCharacterCollisionGroup("Default") end

local function GetCommF()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    return remotes and remotes:FindFirstChild("CommF_")
end

local function HasExcluded(str)
    if type(str) ~= "string" then return false end
    local l = str:lower()
    for _, kw in ipairs(EXCLUDE) do
        if l:find(kw, 1, true) then return true end
    end
    return false
end

local function StripSuffix(name) return (name:gsub("%.%d+$", "")) end

local function IsFruitName(str)
    if type(str) ~= "string" then return false end
    if HasExcluded(str) then return false end
    local cleanName = StripSuffix(str):lower()
    for fname, _ in pairs(FRUIT_CODES) do
        if cleanName == fname:lower() then
            return true
        end
    end
    return false
end

local function IsNpc(inst)
    if inst:FindFirstChild("Humanoid") then return true end
    if inst.Name:lower():find("npc") then return true end
    return false
end

local function IsInsideCharacter(inst)
    local p = inst.Parent
    while p do
        if p:IsA("Model") and p:FindFirstChildOfClass("Humanoid") then return true end
        p = p.Parent
    end
    return false
end

local function GetSize(adornee)
    if adornee:IsA("BasePart") then
        local s = adornee.Size
        return math.max(s.X, s.Y, s.Z)
    end
    return nil
end

local function CountParts(inst)
    if inst:IsA("BasePart") then return 1 end
    local count = 0
    for _, child in ipairs(inst:GetDescendants()) do
        if child:IsA("BasePart") then
            count = count + 1
            if count > CONFIG.MaxFruitParts then return count end
        end
    end
    return count
end

local function IsFruitRelated(inst)
    if IsNpc(inst) then return false end
    if not (inst:IsA("Tool") or inst:IsA("Model")) then return false end
    if not IsFruitName(inst.Name) then return false end
    if IsInsideCharacter(inst) then return false end
    local adornee
    if inst:IsA("Model") then
        adornee = inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
    elseif inst:IsA("Tool") then
        adornee = inst:FindFirstChild("Handle") or inst:FindFirstChildWhichIsA("BasePart", true)
    end
    if not adornee then return false end
    local size = GetSize(adornee)
    if size and size > CONFIG.MaxFruitSize then return false end
    if CountParts(inst) > CONFIG.MaxFruitParts then return false end
    return true
end

local function GetAdornee(inst)
    if inst:IsA("Model") then
        if inst.PrimaryPart then return inst.PrimaryPart end
        local part = inst:FindFirstChildWhichIsA("BasePart", true)
        if part then inst.PrimaryPart = part; return part end
        return nil
    elseif inst:IsA("Tool") then
        local h = inst:FindFirstChild("Handle")
        if h and h:IsA("BasePart") then return h end
        return inst:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end


local function FindBoss()
    local myPos = GetMyPosition()
    if not myPos then return nil end
    local nearest, nearestDist = nil, math.huge
    for _, inst in ipairs(Workspace:GetDescendants()) do
        if inst:IsA("Model") and inst:FindFirstChild("Humanoid") then
            local name = inst.Name:lower()
            for _, bossName in ipairs(BOSS_LIST) do
                if name:find(bossName:lower(), 1, true) then
                    local hrp = inst:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local dist = (hrp.Position - myPos).Magnitude
                        if dist < nearestDist then nearestDist = dist; nearest = hrp end
                    end
                end
            end
        end
    end
    return nearest
end

local function StartAutoBossFarm()
    if AutoBossFarmThread then return end
    AutoBossFarmThread = task.spawn(function()
        while State.AutoBossFarmEnabled do
            task.wait(0.5)
            local boss = FindBoss()
            if boss then
                if LocalPlayer.Character and LocalPlayer.Character.HumanoidRootPart.CollisionGroup ~= NOCLIP_GROUP then
                    EnableNoclip()
                end
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    if not hrp:FindFirstChildOfClass("BodyVelocity") then
                        local bv = Instance.new("BodyVelocity")
                        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                        bv.Parent = hrp
                    end
                    local bv = hrp:FindFirstChildOfClass("BodyVelocity")
                    local dir = boss.Position - hrp.Position
                    if dir.Magnitude > 5 then
                        bv.Velocity = dir.Unit * CONFIG.FlySpeed
                    else
                        bv.Velocity = Vector3.new(0, 0, 0)
                        for _, key in ipairs(SkillKeys) do
                            pcall(function()
                                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode[key], false, game)
                                task.wait(0.05)
                                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[key], false, game)
                            end)
                        end
                    end
                end
            else
                DisableNoclip()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local bv = hrp:FindFirstChildOfClass("BodyVelocity")
                    if bv then bv:Destroy() end
                end
            end
        end
    end)
end


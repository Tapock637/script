local function BuildLookup()
    local set = {}
    for _, name in ipairs(FRUIT_NAMES) do
        set[name:lower()] = true
    end
    return set
end

local FruitLookup = BuildLookup()

local function HasFruitName(str)
    if type(str) ~= "string" then return false end
    return FruitLookup[str:lower()] == true
end

local function IsNpc(inst)
    if inst:FindFirstChild("Humanoid") then return true end
    if inst.Name:lower():find("npc") then return true end
    return false
end

local function IsFruitRelated(inst)
    if IsNpc(inst) then return false end
    if not (inst:IsA("Tool") or inst:IsA("Model")) then return false end
    if HasFruitName(inst.Name) then return true end
    return false
end

local function GetSize(adornee)
    if adornee:IsA("BasePart") then
        local s = adornee.Size
        return math.max(s.X, s.Y, s.Z)
    end
    return nil
end

local function GetAdornee(inst)
    if inst:IsA("Model") then
        if inst.PrimaryPart then return inst.PrimaryPart end
        local part = inst:FindFirstChildWhichIsA("BasePart", true)
        if part then
            inst.PrimaryPart = part
            return part
        end
        return nil
    elseif inst:IsA("Tool") then
        local handle = inst:FindFirstChild("Handle")
        if handle and handle:IsA("BasePart") then return handle end
        return inst:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

local function CreateBillboard(adornee, text, color, size)
    local bb = Instance.new("BillboardGui")
    bb.Name = "FruitESP"
    bb.Adornee = adornee
    bb.AlwaysOnTop = true
    bb.LightInfluence = 0
    bb.Size = size or UDim2.new(0, 240, 0, 40)
    bb.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
    bb.MaxDistance = CONFIG.MaxDistance
    bb.ResetOnSpawn = false
    bb.Parent = adornee

    local label = Instance.new("TextLabel")
    label.Name = "Label"
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, 0, 1, 0)
    label.Font = Enum.Font.GothamBold
    label.TextSize = CONFIG.TextSize
    label.TextColor3 = color
    label.TextStrokeTransparency = 1
    label.Text = text
    label.Parent = bb

    return bb, label
end

local function CreateOutline(adornee, color)
    local hl = Instance.new("Highlight")
    hl.Name = "FruitESP_Highlight"
    hl.Adornee = adornee
    hl.FillColor = color
    hl.OutlineColor = color
    hl.FillTransparency = 1
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = adornee
    return hl
end

local function TryTrackFruit(inst)
    if Tracked[inst] then return end
    if not IsFruitRelated(inst) then return end
    local adornee = GetAdornee(inst)
    if not adornee then return end
    local size = GetSize(adornee)
    if size and size > CONFIG.MaxSize then return end

    local name = inst.Name
    local bb, label = CreateBillboard(adornee, name, CONFIG.FruitColor)
    local hl = CreateOutline(adornee, CONFIG.FruitColor)

    Tracked[inst] = {
        Gui = bb,
        Label = label,
        Highlight = hl,
        Adornee = adornee,
        Name = name,
    }
end

local function RemoveFruit(inst)
    local data = Tracked[inst]
    if not data then return end
    if data.Gui then data.Gui:Destroy() end
    if data.Highlight then data.Highlight:Destroy() end
    Tracked[inst] = nil
end

local function ScanFruits()
    for _, inst in ipairs(Workspace:GetDescendants()) do
        if inst:IsA("Tool") or inst:IsA("Model") then
            TryTrackFruit(inst)
        end
    end
end

local function ApplyPlayerESP(player, isLocal)
    if PlayerESP[player] then
        if PlayerESP[player].Gui then PlayerESP[player].Gui:Destroy() end
        if PlayerESP[player].Highlight then PlayerESP[player].Highlight:Destroy() end
        PlayerESP[player] = nil
    end

    local function setupCharacter(char)
        if char:FindFirstChild("FruitESP") then return end
        local head = char:WaitForChild("Head", 5)
        local hrp = char:WaitForChild("HumanoidRootPart", 5)
        if not head or not hrp then return end

        local color = isLocal and CONFIG.MyColor or CONFIG.PlayerColor
        local prefix = isLocal and "[YOU] " or ""
        local text = prefix .. player.Name

        local bb, label = CreateBillboard(head, text, color, UDim2.new(0, 260, 0, 44))
        local hl = CreateOutline(char, color)

        PlayerESP[player] = {
            Gui = bb,
            Label = label,
            Highlight = hl,
            Head = head,
            BaseText = text,
        }
    end

    if player.Character then
        setupCharacter(player.Character)
    end

    player.CharacterAdded:Connect(function(char)
        task.wait(0.5)
        setupCharacter(char)
    end)
end

local function GetMyPosition()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        return char.HumanoidRootPart.Position
    end
    return nil
end

local function GetNearestFruit()
    local myPos = GetMyPosition()
    if not myPos then return nil end

    local nearest = nil
    local nearestDist = math.huge

    for inst, data in pairs(Tracked) do
        if inst.Parent and data.Adornee and data.Adornee.Parent then
            local dist = (data.Adornee.Position - myPos).Magnitude
            if dist < nearestDist then
                nearestDist = dist
                nearest = data.Adornee
            end
        end
    end

    return nearest
end

local function FindCafePosition()
    local best = nil
    local bestDist = math.huge
    local myPos = GetMyPosition()
    if not myPos then return nil end

    for _, inst in ipairs(Workspace:GetDescendants()) do
        if inst:IsA("BasePart") or inst:IsA("Model") then
            local name = inst.Name:lower()
            local matched = false
            for _, kw in ipairs(CONFIG.CafeKeywords) do
                if name:find(kw, 1, true) then
                    matched = true
                    break
                end
            end
            if matched then
                local pos = nil
                if inst:IsA("BasePart") then
                    pos = inst.Position
                elseif inst:IsA("Model") then
                    if inst.PrimaryPart then
                        pos = inst.PrimaryPart.Position
                    else
                        local part = inst:FindFirstChildWhichIsA("BasePart", true)
                        if part then pos = part.Position end
                    end
                end
                if pos then
                    local dist = (pos - myPos).Magnitude
                    if dist < bestDist then
                        bestDist = dist
                        best = inst
                    end
                end
            end
        end
    end

    if best then
        if best:IsA("BasePart") then return best
        elseif best:IsA("Model") then
            if best.PrimaryPart then return best.PrimaryPart end
            return best:FindFirstChildWhichIsA("BasePart", true)
        end
    end
    return nil
end


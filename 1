local function UpdateScale()
    local vp = Workspace.CurrentCamera.ViewportSize
    local baseW, baseH = 720, 420
    local fw = (vp.X * 0.9) / baseW
    local fh = (vp.Y * 0.85) / baseH
    local scale = math.clamp(math.min(fw, fh), 0.35, 1)
    if isMobile then
        scale = scale * 0.67
        MainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
        MainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
    end
    MenuScale.Scale = scale
    local btnScale = math.clamp(vp.X / 1920, 0.75, 1)
    if isMobile then btnScale = btnScale * 0.85 end
    BtnScale.Scale = btnScale
end

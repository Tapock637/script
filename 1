local function StartFly()
    if FlyActive then return end
    FlyActive = true

    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then
        FlyActive = false
        return
    end

    local target = GetNearestFruit()
    if not target then
        notify("NO FRUIT FOUND", Color3.fromRGB(255, 160, 60))
        FlyActive = false
        return
    end

    local speed = 100
    local reachDist = 3

    FlyConnection = RunService.Heartbeat:Connect(function(dt)
        if not FlyActive then return end

        local char = LocalPlayer.Character
        if not char then
            FlyActive = false
            if FlyConnection then FlyConnection:Disconnect() end
            return
        end

        local currentHrp = char:FindFirstChild("HumanoidRootPart")
        if not currentHrp then
            FlyActive = false
            if FlyConnection then FlyConnection:Disconnect() end
            return
        end

        if not target.Parent then
            target = GetNearestFruit()
            if not target then
                FlyActive = false
                if FlyConnection then FlyConnection:Disconnect() end
                return
            end
        end

        local targetPos = target.Position
        local myPos = currentHrp.Position
        local dir = (targetPos - myPos)

        if dir.Magnitude <= reachDist then
            FlyActive = false
            if FlyConnection then FlyConnection:Disconnect() end
            return
        end

        dir = dir.Unit
        local move = dir * speed * dt
        currentHrp.CFrame = currentHrp.CFrame + move
        currentHrp.Velocity = Vector3.new(0, 0, 0)
    end)
end

local function StopFly()
    FlyActive = false
    if FlyConnection then
        FlyConnection:Disconnect()
        FlyConnection = nil
    end
end

local function StartRun()
    if RunActive then return end
    RunActive = true

    local lastJump = 0
    local jumpSpam = false
    local spamUntil = 0

    RunConnection = RunService.Heartbeat:Connect(function(dt)
        if not RunActive then return end

        local char = LocalPlayer.Character
        if not char then return end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return end

        local target = GetNearestFruit()
        if not target then
            RunActive = false
            if RunConnection then RunConnection:Disconnect() end
            return
        end

        local targetPos = target.Position
        local myPos = hrp.Position
        local dir = (targetPos - myPos)

        if dir.Magnitude <= 4 then
            RunActive = false
            if RunConnection then RunConnection:Disconnect() end
            return
        end

        local now = tick()
        local currentHealth = hum.Health
        if hum:GetAttribute("LastHealth") then
            local lastHealth = hum:GetAttribute("LastHealth")
            if currentHealth < lastHealth then
                jumpSpam = true
                spamUntil = now + 1.5
            end
        end
        hum:SetAttribute("LastHealth", currentHealth)

        local flatDir = Vector3.new(dir.X, 0, dir.Z)
        if flatDir.Magnitude > 0 then
            flatDir = flatDir.Unit
            local move = flatDir * hum.WalkSpeed * dt
            hrp.CFrame = hrp.CFrame + move
        end

        local rayOrigin = hrp.Position
        local rayDir = flatDir * 5
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = {char}

        local rayResult = workspace:Raycast(rayOrigin, rayDir, rayParams)
        local wallBlocked = rayResult ~= nil

        local downRay = workspace:Raycast(rayOrigin, Vector3.new(0, -10, 0), rayParams)
        local voidAhead = downRay == nil

        local shouldJump = false

        if wallBlocked then
            shouldJump = true
        end

        if voidAhead then
            if now - lastJump >= 1 then
                shouldJump = true
            end
        end

        if jumpSpam then
            if now < spamUntil then
                shouldJump = true
            else
                jumpSpam = false
            end
        end

        if shouldJump then
            hum.Jump = true
            lastJump = now
        end
    end)
end

local function StopRun()
    RunActive = false
    if RunConnection then
        RunConnection:Disconnect()
        RunConnection = nil
    end
end


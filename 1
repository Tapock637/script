local function GetFruitCode(toolName)
    if FRUIT_CODES[toolName] then return FRUIT_CODES[toolName] end
    local base = toolName:gsub(" Fruit", "")
    if FRUIT_CODES[base .. " Fruit"] then return FRUIT_CODES[base .. " Fruit"] end
    return base .. "-" .. base
end

local function FindFruitTool()
    local char = LocalPlayer.Character
    if not char then return nil end
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") and IsFruitName(child.Name) and not HasExcluded(child.Name) then return child end
    end
    if backpack then
        for _, child in ipairs(backpack:GetChildren()) do
            if child:IsA("Tool") and IsFruitName(child.Name) and not HasExcluded(child.Name) then return child end
        end
    end
    return nil
end

local function TryStoreFruit()
    local tool = FindFruitTool()
    if not tool then return false end
    local commF = GetCommF()
    if not commF then return false end
    local code = GetFruitCode(tool.Name)
    local attempts = { {code, tool}, {code, tool.Name}, {tool.Name, tool}, {tool.Name}, {code} }
    for _, args in ipairs(attempts) do
        local ok = pcall(function() return commF:InvokeServer("StoreFruit", unpack(args)) end)
        if ok then task.wait(0.3); if not tool.Parent then return true end end
    end
    return false
end

local function UnequipNonFruits()
    local char = LocalPlayer.Character
    if not char then return end
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then return end
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") and not IsFruitName(child.Name) then
            pcall(function() child.Parent = backpack end)
        end
    end
end

local function ServerHop()
    local servers = {}
    local success, response = pcall(function()
        return game:HttpGet(
            "https://games.roproxy.com/v1/games/" .. CONFIG.PlaceId ..
            "/servers/Public?sortOrder=Asc&limit=100&excludeFullGames=true"
        )
    end)
    if success and response then
        local ok, data = pcall(function() return HttpService:JSONDecode(response) end)
        if ok and data and data.data then
            for _, server in ipairs(data.data) do
                if server.id ~= game.JobId and server.playing < CONFIG.MaxPlayersForHop then
                    table.insert(servers, server.id)
                end
            end
        end
    end
    if #servers > 0 then
        local randomServer = servers[math.random(1, #servers)]
        pcall(function() TeleportService:TeleportToPlaceInstance(CONFIG.PlaceId, randomServer, LocalPlayer) end)
    else
        pcall(function() TeleportService:Teleport(CONFIG.PlaceId, LocalPlayer) end)
    end
end


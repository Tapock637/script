local function StopAutoFruit()
    AutoFruitActive = false
    if AutoThread then task.cancel(AutoThread) AutoThread = nil end
    if AutoFlyConn then AutoFlyConn:Disconnect() AutoFlyConn = nil end
    SetCollision(true)
end

local function StartAutoFruit()
    if AutoFruitActive then return true end

    if not IsTeamSelected() then
        selectTeam()
        task.wait(2.5)
        if not IsTeamSelected() then
            return false
        end
    end

    AutoFruitActive = true

    AutoFlyConn = RunService.Heartbeat:Connect(function(dt)
        if not AutoFruitActive then return end
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local target = GetNearestFruit()
        if not target then
            SetCollision(true)
            local bv = hrp:FindFirstChildOfClass("BodyVelocity")
            if bv then bv:Destroy() end
            return
        end

        SetCollision(false)

        if not hrp:FindFirstChildOfClass("BodyVelocity") then
            local bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bv.Velocity = Vector3.new(0, 0, 0)
            bv.Parent = hrp
        end

        local bv = hrp:FindFirstChildOfClass("BodyVelocity")
        local dir = target.Position - hrp.Position
        if dir.Magnitude <= CONFIG.ReachDistance then
            bv.Velocity = Vector3.new(0, 0, 0)
            return
        end
        bv.Velocity = dir.Unit * CONFIG.FlySpeed
    end)

    AutoThread = task.spawn(function()
        local emptyTimer = 0
        local lastCheck = tick()
        while AutoFruitActive do
            task.wait(0.5)
            local now = tick()
            local dt = now - lastCheck
            lastCheck = now

            for inst, data in pairs(Tracked) do
                if not inst.Parent or not data.Adornee or not data.Adornee.Parent then
                    RemoveFruit(inst)
                end
            end

            if HasAnyFruit() then
                emptyTimer = 0
            else
                emptyTimer = emptyTimer + dt
                if emptyTimer >= CONFIG.FruitLostDelay then
                    -- Сохраняем что осталось
                    TryStoreFruit()
                    task.wait(CONFIG.ServerHopDelay)
                    ServerHop()
                    return
                end
            end
        end
    end)

    return true
end


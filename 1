HomeThread = task.spawn(function()
    while true do
        task.wait(1)

        -- Playtime (время с запуска скрипта)
        local playtime = tick() - playtimeStart
        local ph = math.floor(playtime / 3600)
        local pm = math.floor((playtime % 3600) / 60)
        local ps = math.floor(playtime % 60)
        if playtimeLabel then playtimeLabel.Text = string.format("Playtime: %02d:%02d:%02d", ph, pm, ps) end

        -- Server Age (реальное время работы сервера через DistributedGameTime)
        local serverTime = Workspace.DistributedGameTime
        local sh = math.floor(serverTime / 3600)
        local sm = math.floor((serverTime % 3600) / 60)
        local ss = math.floor(serverTime % 60)
        if serverTimeLabel then serverTimeLabel.Text = string.format("Server Age: %02d:%02d:%02d", sh, sm, ss) end

        local fullMoonCycle = 8 * 20 * 60
        local timeUntil = fullMoonCycle - (serverTime % fullMoonCycle)
        if timeUntil > fullMoonCycle - 55 * 60 then timeUntil = timeUntil - fullMoonCycle end
        if fullMoonLabel then
            local fh = math.floor(timeUntil / 3600)
            local fm = math.floor((timeUntil % 3600) / 60)
            local fs = math.floor(timeUntil % 60)
            fullMoonLabel.Text = string.format("Full Moon: %02d:%02d:%02d", fh, fm, fs)
        end

        local factoryCycle = 90 * 60
        local timeUntilFactory = factoryCycle - (serverTime % factoryCycle)
        if factoryLabel then
            local fah = math.floor(timeUntilFactory / 3600)
            local fam = math.floor((timeUntilFactory % 3600) / 60)
            local fas = math.floor(timeUntilFactory % 60)
            factoryLabel.Text = string.format("Factory: %02d:%02d:%02d", fah, fam, fas)
        end

        local pirateCycle = 75 * 60
        local timeUntilPirate = pirateCycle - (serverTime % pirateCycle)
        if pirateLabel then
            local pah = math.floor(timeUntilPirate / 3600)
            local pam = math.floor((timeUntilPirate % 3600) / 60)
            local pas = math.floor(timeUntilPirate % 60)
            pirateLabel.Text = string.format("Pirate Attack: %02d:%02d:%02d", pah, pam, pas)
        end

        local isWeekend = false
        local day = os.date("*t").wday
        if day == 1 or day == 7 then isWeekend = true end
        local fruitCycle = isWeekend and 45 * 60 or 60 * 60
        local timeUntilFruit = fruitCycle - (serverTime % fruitCycle)
        if fruitSpawnLabel then
            local frh = math.floor(timeUntilFruit / 3600)
            local frm = math.floor((timeUntilFruit % 3600) / 60)
            local frs = math.floor(timeUntilFruit % 60)
            fruitSpawnLabel.Text = string.format("Fruit Spawn: %02d:%02d:%02d", frh, frm, frs)
        end
    end
end)


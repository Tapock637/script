local function loadConfig()
    if not (isfile and readfile) then return end
    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(CONFIG.ConfigFile))
    end)
    if ok and data and data.AutoFruit ~= nil then
        State.AutoFruit = data.AutoFruit
    end
end

local function saveConfig()
    if not (writefile and isfile) then return end
    pcall(function()
        writefile(CONFIG.ConfigFile, HttpService:JSONEncode({ AutoFruit = State.AutoFruit }))
    end)
end

local function HasExcluded(str)
    if type(str) ~= "string" then return false end
    local l = str:lower()
    for _, kw in ipairs(EXCLUDE) do
        if l:find(kw, 1, true) then return true end
    end
    return false
end

local function IsKnownFruit(str)
    if type(str) ~= "string" then return false end
    if FRUIT_CODES[str] then return true end
    local l = str:lower()
    for fname, _ in pairs(FRUIT_CODES) do
        local fl = fname:lower()
        local base = fl:gsub(" fruit","")
        if l == fl or l == base then return true end
    end
    return false
end

local function IsFruitName(str)
    if type(str) ~= "string" then return false end
    local l = str:lower()
    if l:find("fruit", 1, true) then
        if HasExcluded(str) then return false end
        local c = l:gsub("fruit",""):gsub("%s+","")
        if c == "" or c:match("^%d+$") then return false end
        return true
    end
    if IsKnownFruit(str) then return true end
    return false
end

local function IsNpc(inst)
    if inst:FindFirstChild("Humanoid") then return true end
    if inst.Name:lower():find("npc") then return true end
    return false
end

local function IsInsideCharacter(inst)
    local p = inst.Parent
    while p do
        if p:IsA("Model") and p:FindFirstChildOfClass("Humanoid") then
            return true
        end
        p = p.Parent
    end
    return false
end

local function IsFruitRelated(inst)
    if IsNpc(inst) then return false end
    if not (inst:IsA("Tool") or inst:IsA("Model")) then return false end
    if not IsFruitName(inst.Name) then return false end
    if IsInsideCharacter(inst) then return false end
    if inst:IsA("Model") and not inst:FindFirstChildWhichIsA("BasePart", true) then
        return false
    end
    return true
end

local function GetSize(adornee)
    if adornee:IsA("BasePart") then
        local s = adornee.Size
        return math.max(s.X, s.Y, s.Z)
    end
    return nil
end

local function GetAdornee(inst)
    if inst:IsA("Model") then
        if inst.PrimaryPart then return inst.PrimaryPart end
        local part = inst:FindFirstChildWhichIsA("BasePart", true)
        if part then
            inst.PrimaryPart = part
            return part
        end
        return nil
    elseif inst:IsA("Tool") then
        local h = inst:FindFirstChild("Handle")
        if h and h:IsA("BasePart") then return h end
        return inst:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

local function CreateBillboard(adornee, text, color)
    local bb = Instance.new("BillboardGui")
    bb.Name = "FruitESP"
    bb.Adornee = adornee
    bb.AlwaysOnTop = true
    bb.LightInfluence = 0
    bb.Size = UDim2.new(0, 240, 0, 40)
    bb.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
    bb.MaxDistance = 0
    bb.ResetOnSpawn = false
    bb.Parent = adornee

    local label = Instance.new("TextLabel")
    label.Name = "Label"
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, 0, 1, 0)
    label.Font = Enum.Font.GothamBold
    label.TextSize = CONFIG.TextSize
    label.TextColor3 = color
    label.TextStrokeTransparency = 1
    label.Text = text
    label.Parent = bb

    return bb, label
end

local function CreateOutline(adornee, color)
    local hl = Instance.new("Highlight")
    hl.Name = "FruitESP_Highlight"
    hl.Adornee = adornee
    hl.FillColor = color
    hl.OutlineColor = color
    hl.FillTransparency = 1
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = adornee
    return hl
end

local function TryTrackFruit(inst)
    if Tracked[inst] then return end
    if not IsFruitRelated(inst) then return end
    local adornee = GetAdornee(inst)
    if not adornee then return end
    local size = GetSize(adornee)
    if size and size > CONFIG.MaxSize then return end
    local bb, label = CreateBillboard(adornee, inst.Name, CONFIG.FruitColor)
    local hl = CreateOutline(adornee, CONFIG.FruitColor)
    Tracked[inst] = { Gui = bb, Label = label, Highlight = hl, Adornee = adornee, Name = inst.Name }
end

local function RemoveFruit(inst)
    local d = Tracked[inst]
    if not d then return end
    if d.Gui then d.Gui:Destroy() end
    if d.Highlight then d.Highlight:Destroy() end
    Tracked[inst] = nil
end

local function ScanFruits()
    for _, inst in ipairs(Workspace:GetDescendants()) do
        if inst:IsA("Tool") or inst:IsA("Model") then
            TryTrackFruit(inst)
        end
    end
end

local function GetMyPosition()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        return char.HumanoidRootPart.Position
    end
    return nil
end

local function GetNearestFruit()
    local myPos = GetMyPosition()
    if not myPos then return nil end
    local nearest, nearestDist = nil, math.huge
    for inst, data in pairs(Tracked) do
        if inst.Parent and data.Adornee and data.Adornee.Parent then
            local dist = (data.Adornee.Position - myPos).Magnitude
            if dist < nearestDist then
                nearestDist = dist
                nearest = data.Adornee
            end
        end
    end
    return nearest
end

local function HasAnyFruit()
    for inst, data in pairs(Tracked) do
        if inst.Parent and data.Adornee and data.Adornee.Parent then
            return true
        end
    end
    return false
end

local function SetCollision(enabled)
    local char = LocalPlayer.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = enabled
        end
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then hrp.CanCollide = enabled end
end

local function IsTeamSelected()
    if LocalPlayer.Team ~= nil and LocalPlayer.Team.Name ~= "" then
        return true
    end
    local data = LocalPlayer:FindFirstChild("Data")
    if data then
        local team = data:FindFirstChild("Team")
        if team and team.Value ~= "" then return true end
    end
    return false
end

local function selectTeam()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local commF = remotes and remotes:FindFirstChild("CommF_")
    if not commF then return false end
    return pcall(function()
        commF:InvokeServer("SetTeam", CONFIG.Team)
    end)
end

-- ================= STORE FRUIT (более надёжный) =================
local function GetFruitCode(toolName)
    -- 1. Прямое совпадение по таблице
    if FRUIT_CODES[toolName] then
        return FRUIT_CODES[toolName]
    end
    -- 2. Если название с " Fruit" на конце
    local base = toolName:gsub(" Fruit", "")
    if FRUIT_CODES[base .. " Fruit"] then
        return FRUIT_CODES[base .. " Fruit"]
    end
    -- 3. Генерируем код
    return base .. "-" .. base
end

local function FindFruitTool()
    local char = LocalPlayer.Character
    if not char then return nil end
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    
    -- Ищем в руках
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") and IsFruitName(child.Name) and not HasExcluded(child.Name) then
            return child
        end
    end
    -- Ищем в рюкзаке
    if backpack then
        for _, child in ipairs(backpack:GetChildren()) do
            if child:IsA("Tool") and IsFruitName(child.Name) and not HasExcluded(child.Name) then
                return child
            end
        end
    end
    return nil
end

local function TryStoreFruit()
    local tool = FindFruitTool()
    if not tool then return false end
    
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local commF = remotes and remotes:FindFirstChild("CommF_")
    if not commF then return false end
    
    local code = GetFruitCode(tool.Name)
    
    -- Пробуем разные варианты
    local attempts = {
        {code, tool},
        {code, tool.Name},
        {tool.Name, tool},
        {tool.Name},
        {code},
    }
    
    for _, args in ipairs(attempts) do
        local ok, result = pcall(function()
            return commF:InvokeServer("StoreFruit", unpack(args))
        end)
        if ok then
            task.wait(0.3)
            -- Проверяем, исчез ли фрукт
            if not tool.Parent then
                return true
            end
        end
    end
    
    return false
end

-- Снятие инструментов (только не-фруктов, чтобы не мешали)
local function UnequipNonFruits()
    local char = LocalPlayer.Character
    if not char then return end
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then return end
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") then
            -- Не снимаем фрукты, они нужны для стора
            if not IsFruitName(child.Name) then
                pcall(function()
                    child.Parent = backpack
                end)
            end
        end
    end
end

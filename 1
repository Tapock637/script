local function loadConfig()
    if not (isfile and readfile) then return end
    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(CONFIG.ConfigFile))
    end)
    if ok and data then
        if data.ShowFruits ~= nil then State.ShowFruits = data.ShowFruits end
        if data.ShowPlayers ~= nil then State.ShowPlayers = data.ShowPlayers end
        if data.AutoFruit ~= nil then State.AutoFruit = data.AutoFruit end
    end
end

local function saveConfig()
    if not (writefile and isfile) then return end
    local data = {
        ShowFruits = State.ShowFruits,
        ShowPlayers = State.ShowPlayers,
        AutoFruit = State.AutoFruit,
    }
    pcall(function()
        writefile(CONFIG.ConfigFile, HttpService:JSONEncode(data))
    end)
end

local function IsTeamSelected()
    -- Проверяем через Player.Team
    if LocalPlayer.Team ~= nil and LocalPlayer.Team.Name ~= "" then
        return true
    end
    -- Проверяем через Data.Team
    local data = LocalPlayer:FindFirstChild("Data")
    if data then
        local team = data:FindFirstChild("Team")
        if team and team.Value ~= "" then
            return true
        end
    end
    return false
end

local function selectTeam()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local commF = remotes and remotes:FindFirstChild("CommF_")
    if not commF then
        notify("CommF_ not found", Color3.fromRGB(255, 100, 100))
        return false
    end

    local ok, result = pcall(function()
        return commF:InvokeServer("SetTeam", CONFIG.Team)
    end)

    if ok then
        return true
    end
    return false
end

local function HasExcludedKeyword(str)
    if type(str) ~= "string" then return false end
    local lower = str:lower()
    for _, kw in ipairs(EXCLUDE_KEYWORDS) do
        if lower:find(kw, 1, true) then
            return true
        end
    end
    return false
end

local function HasFruitName(str)
    if type(str) ~= "string" then return false end
    for name, _ in pairs(FRUIT_CODES) do
        if str:lower() == name:lower() then
            return true
        end
    end
    return false
end

local function IsNpc(inst)
    if inst:FindFirstChild("Humanoid") then return true end
    if inst.Name:lower():find("npc") then return true end
    return false
end

local function IsFruitRelated(inst)
    if IsNpc(inst) then return false end
    if not (inst:IsA("Tool") or inst:IsA("Model")) then return false end
    if HasExcludedKeyword(inst.Name) then return false end
    if not HasFruitName(inst.Name) then return false end
    if inst:IsA("Model") then
        local hasPart = inst:FindFirstChildWhichIsA("BasePart", true)
        if not hasPart then return false end
    end
    return true
end

local function GetSize(adornee)
    if adornee:IsA("BasePart") then
        local s = adornee.Size
        return math.max(s.X, s.Y, s.Z)
    end
    return nil
end

local function GetAdornee(inst)
    if inst:IsA("Model") then
        if inst.PrimaryPart then return inst.PrimaryPart end
        local part = inst:FindFirstChildWhichIsA("BasePart", true)
        if part then
            inst.PrimaryPart = part
            return part
        end
        return nil
    elseif inst:IsA("Tool") then
        local handle = inst:FindFirstChild("Handle")
        if handle and handle:IsA("BasePart") then return handle end
        return inst:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

local function CreateBillboard(adornee, text, color, size)
    local bb = Instance.new("BillboardGui")
    bb.Name = "FruitESP"
    bb.Adornee = adornee
    bb.AlwaysOnTop = true
    bb.LightInfluence = 0
    bb.Size = size or UDim2.new(0, 240, 0, 40)
    bb.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
    bb.MaxDistance = CONFIG.MaxDistance
    bb.ResetOnSpawn = false
    bb.Parent = adornee

    local label = Instance.new("TextLabel")
    label.Name = "Label"
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, 0, 1, 0)
    label.Font = Enum.Font.GothamBold
    label.TextSize = CONFIG.TextSize
    label.TextColor3 = color
    label.TextStrokeTransparency = 1
    label.Text = text
    label.Parent = bb

    return bb, label
end

local function CreateOutline(adornee, color)
    local hl = Instance.new("Highlight")
    hl.Name = "FruitESP_Highlight"
    hl.Adornee = adornee
    hl.FillColor = color
    hl.OutlineColor = color
    hl.FillTransparency = 1
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = adornee
    return hl
end

local function TryTrackFruit(inst)
    if Tracked[inst] then return end
    if not IsFruitRelated(inst) then return end
    local adornee = GetAdornee(inst)
    if not adornee then return end
    local size = GetSize(adornee)
    if size and size > CONFIG.MaxSize then return end

    local name = inst.Name
    local bb, label = CreateBillboard(adornee, name, CONFIG.FruitColor)
    local hl = CreateOutline(adornee, CONFIG.FruitColor)

    Tracked[inst] = {
        Gui = bb,
        Label = label,
        Highlight = hl,
        Adornee = adornee,
        Name = name,
    }
end

local function RemoveFruit(inst)
    local data = Tracked[inst]
    if not data then return end
    if data.Gui then data.Gui:Destroy() end
    if data.Highlight then data.Highlight:Destroy() end
    Tracked[inst] = nil
end

local function ScanFruits()
    for _, inst in ipairs(Workspace:GetDescendants()) do
        if inst:IsA("Tool") or inst:IsA("Model") then
            TryTrackFruit(inst)
        end
    end
end

local function ApplyPlayerESP(player, isLocal)
    if PlayerESP[player] then
        if PlayerESP[player].Gui then PlayerESP[player].Gui:Destroy() end
        if PlayerESP[player].Highlight then PlayerESP[player].Highlight:Destroy() end
        PlayerESP[player] = nil
    end

    local function setupCharacter(char)
        if char:FindFirstChild("FruitESP") then return end
        local head = char:WaitForChild("Head", 5)
        local hrp = char:WaitForChild("HumanoidRootPart", 5)
        if not head or not hrp then return end

        local color = isLocal and CONFIG.MyColor or CONFIG.PlayerColor
        local prefix = isLocal and "[YOU] " or ""
        local text = prefix .. player.Name

        local bb, label = CreateBillboard(head, text, color, UDim2.new(0, 260, 0, 44))
        local hl = CreateOutline(char, color)

        PlayerESP[player] = {
            Gui = bb,
            Label = label,
            Highlight = hl,
            Head = head,
            BaseText = text,
        }
    end

    if player.Character then
        setupCharacter(player.Character)
    end

    player.CharacterAdded:Connect(function(char)
        task.wait(0.5)
        setupCharacter(char)
    end)
end

local function GetMyPosition()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        return char.HumanoidRootPart.Position
    end
    return nil
end

local function GetNearestFruit()
    local myPos = GetMyPosition()
    if not myPos then return nil end

    local nearest = nil
    local nearestDist = math.huge

    for inst, data in pairs(Tracked) do
        if inst.Parent and data.Adornee and data.Adornee.Parent then
            local dist = (data.Adornee.Position - myPos).Magnitude
            if dist < nearestDist then
                nearestDist = dist
                nearest = data.Adornee
            end
        end
    end

    return nearest
end

local function HasAnyFruit()
    for inst, data in pairs(Tracked) do
        if inst.Parent and data.Adornee and data.Adornee.Parent then
            return true
        end
    end
    return false
end

local function FindCafePosition()
    local best = nil
    local bestDist = math.huge
    local myPos = GetMyPosition()
    if not myPos then return nil end

    for _, inst in ipairs(Workspace:GetDescendants()) do
        if inst:IsA("BasePart") or inst:IsA("Model") then
            local name = inst.Name:lower()
            local matched = false
            for _, kw in ipairs(CONFIG.CafeKeywords) do
                if name:find(kw, 1, true) then
                    matched = true
                    break
                end
            end
            if matched then
                local pos = nil
                if inst:IsA("BasePart") then
                    pos = inst.Position
                elseif inst:IsA("Model") then
                    if inst.PrimaryPart then
                        pos = inst.PrimaryPart.Position
                    else
                        local part = inst:FindFirstChildWhichIsA("BasePart", true)
                        if part then pos = part.Position end
                    end
                end
                if pos then
                    local dist = (pos - myPos).Magnitude
                    if dist < bestDist then
                        bestDist = dist
                        best = inst
                    end
                end
            end
        end
    end

    if best then
        if best:IsA("BasePart") then return best
        elseif best:IsA("Model") then
            if best.PrimaryPart then return best.PrimaryPart end
            return best:FindFirstChildWhichIsA("BasePart", true)
        end
    end
    return nil
end

local function TryStoreFruit()
    local char = LocalPlayer.Character
    if not char then return false, "No character" end

    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then return false, "No backpack" end

    local fruitTool = nil
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") and HasFruitName(child.Name) then
            fruitTool = child
            break
        end
    end
    if not fruitTool then
        for _, child in ipairs(backpack:GetChildren()) do
            if child:IsA("Tool") and HasFruitName(child.Name) then
                fruitTool = child
                break
            end
        end
    end

    if not fruitTool then
        return false, "No fruit in hand or backpack"
    end

    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local commF = remotes and remotes:FindFirstChild("CommF_")
    if not commF then return false, "No CommF_" end

    local fruitCode = FRUIT_CODES[fruitTool.Name]
    if not fruitCode then
        local baseName = fruitTool.Name:gsub(" Fruit", "")
        fruitCode = baseName .. "-" .. baseName
    end

    local ok, result = pcall(function()
        return commF:InvokeServer("StoreFruit", fruitCode, fruitTool)
    end)

    if ok and result then
        return true, "Stored " .. fruitTool.Name
    end
    return false, "Store failed for " .. fruitTool.Name
end

local function ServerHop()
    pcall(function()
        local url = "https://games.roblox.com/v1/games/" .. CONFIG.PlaceId .. "/servers/Public?limit=100"
        local response = game:HttpGet(url)
        local data = HttpService:JSONDecode(response)

        local servers = {}
        for _, server in ipairs(data.data) do
            if server.id ~= game.JobId and server.playing < server.maxPlayers then
                table.insert(servers, server.id)
            end
        end

        if #servers > 0 then
            local randomServer = servers[math.random(1, #servers)]
            TeleportService:TeleportToPlaceInstance(CONFIG.PlaceId, randomServer, LocalPlayer)
        else
            TeleportService:Teleport(CONFIG.PlaceId, LocalPlayer)
        end
    end)
end

local function SetCharacterCollision(enabled)
    local char = LocalPlayer.Character
    if not char then return end

    local partsToChange = {
        "Torso", "UpperTorso", "LowerTorso",
        "Left Leg", "Right Leg",
    }

    for _, partName in ipairs(partsToChange) do
        local part = char:FindFirstChild(partName)
        if part and part:IsA("BasePart") then
            part.CanCollide = enabled
        end
    end
end

local function StopFly()
    FlyActive = false
    if FlyConnection then
        FlyConnection:Disconnect()
        FlyConnection = nil
    end
    SetCharacterCollision(true)

    local char = LocalPlayer.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.Velocity = Vector3.new(0, 0, 0)
        end
    end
end

local function StartFly()
    if FlyActive then return end

    local char = LocalPlayer.Character
    if not char then return end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local target = GetNearestFruit()
    if not target then
        notify("No fruit to fly to", Color3.fromRGB(255, 160, 60))
        return
    end

    FlyActive = true
    SetCharacterCollision(false)

    local speed = 100
    local reachDist = 3
    local lostTimer = 0

    local bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    bodyVelocity.Parent = hrp

    FlyConnection = RunService.Heartbeat:Connect(function(dt)
        if not FlyActive then
            if FlyConnection then FlyConnection:Disconnect() end
            bodyVelocity:Destroy()
            return
        end

        local c = LocalPlayer.Character
        if not c then StopFly() return end

        local currentHrp = c:FindFirstChild("HumanoidRootPart")
        if not currentHrp then StopFly() return end

        if not target.Parent then
            lostTimer = lostTimer + dt
            if lostTimer >= CONFIG.FruitLostDelay then
                StopFly()
                if AutoFruitActive then
                    TryStoreFruit()
                    task.wait(CONFIG.ServerHopDelay)
                    ServerHop()
                end
                return
            end
            target = GetNearestFruit()
            if target then lostTimer = 0 end
            if not target then return end
        else
            lostTimer = 0
        end

        local targetPos = target.Position
        local myPos = currentHrp.Position
        local dir = (targetPos - myPos)

        if dir.Magnitude <= reachDist then
            StopFly()
            return
        end

        dir = dir.Unit
        bodyVelocity.Velocity = dir * speed
    end)
end

local function StopRun()
    RunActive = false
    if RunThread then
        task.cancel(RunThread)
        RunThread = nil
    end
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum:MoveTo(char.HumanoidRootPart.Position)
        end
    end
end

local function StartRun()
    if RunActive then return end

    local char = LocalPlayer.Character
    if not char then return end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    local target = GetNearestFruit()
    if not target then
        notify("No fruit to run to", Color3.fromRGB(255, 160, 60))
        return
    end

    RunActive = true

    RunThread = task.spawn(function()
        while RunActive do
            local c = LocalPlayer.Character
            if not c then StopRun() return end

            local currentHrp = c:FindFirstChild("HumanoidRootPart")
            local currentHum = c:FindFirstChildOfClass("Humanoid")
            if not currentHrp or not currentHum then StopRun() return end

            local t = GetNearestFruit()
            if not t then
                StopRun()
                notify("No fruit found", Color3.fromRGB(255, 160, 60))
                return
            end

            local dist = (t.Position - currentHrp.Position).Magnitude
            if dist <= 4 then
                StopRun()
                notify("Arrived at fruit", Color3.fromRGB(100, 255, 120))
                return
            end

            local path = PathfindingService:CreatePath({
                AgentRadius = 2,
                AgentHeight = 5,
                AgentCanJump = true,
                AgentCanClimb = true,
                WaypointSpacing = 4,
            })

            local success = pcall(function()
                path:ComputeAsync(currentHrp.Position, t.Position)
            end)

            if success and path.Status == Enum.PathStatus.Success then
                local waypoints = path:GetWaypoints()
                for _, wp in ipairs(waypoints) do
                    if not RunActive then return end
                    if wp.Action == Enum.PathWaypointAction.Jump then
                        currentHum.Jump = true
                    end
                    currentHum:MoveTo(wp.Position)
                    local wpReached = false
                    local timeout = tick() + 4
                    repeat
                        task.wait(0.1)
                        if not RunActive then return end
                        if not currentHrp.Parent then StopRun() return end
                        local d = (currentHrp.Position - wp.Position).Magnitude
                        if d < 3 then wpReached = true end
                        if tick() > timeout then wpReached = true end
                    until wpReached
                end
            else
                currentHum:MoveTo(t.Position)
                local timeout = tick() + 3
                repeat
                    task.wait(0.1)
                    if not RunActive then return end
                    if not currentHrp.Parent then StopRun() return end
                    local d = (t.Position - currentHrp.Position).Magnitude
                    if d < 4 then break end
                    if tick() > timeout then break end
                until false
            end

            task.wait(0.2)
        end
    end)
end


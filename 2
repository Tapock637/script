-- Нормализуем шансы (сумма = 100)
local totalChance = 0
for _, f in ipairs(FRUITS) do totalChance = totalChance + f.chance end
if totalChance > 0 then
    for _, f in ipairs(FRUITS) do f.chance = f.chance / totalChance * 100 end
end

-- Функция выбора фрукта по шансам
local function rollFruit()
    local roll = math.random() * 100
    local acc = 0
    for _, f in ipairs(FRUITS) do
        acc = acc + f.chance
        if roll <= acc then return f end
    end
    return FRUITS[1]
end


-- Поиск всего, что похоже на серверный аптайм / время старта
local function scan(obj, path, depth)
    if depth > 4 then return end
    for _, child in ipairs(obj:GetChildren()) do
        local childPath = path .. "." .. child.Name
        -- NumberValue / IntValue с большими числами или словом time/start
        if child:IsA("NumberValue") or child:IsA("IntValue") or child:IsA("StringValue") then
            local name = child.Name:lower()
            if name:find("time") or name:find("start") or name:find("server") or name:find("age") or name:find("uptime") then
                print("[FOUND]", childPath, "=", child.Value)
            end
        end
        -- Attribute
        local ok, attrs = pcall(function() return child:GetAttributes() end)
        if ok and type(attrs) == "table" then
            for aName, aVal in pairs(attrs) do
                local ln = aName:lower()
                if ln:find("time") or ln:find("start") or ln:find("server") then
                    print("[ATTR]", childPath .. ":" .. aName, "=", tostring(aVal))
                end
            end
        end
        scan(child, childPath, depth + 1)
    end
end


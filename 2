-- Перетаскивание окна
local dragging, dragStart, startPos
MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
    end
end)
MainFrame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- ========== Логика прокрутки ==========
local spinning = false

local function playSpinAnimation(callback)
    if spinning then return end
    spinning = true

    -- Сброс
    ResultLabel.Text = "Крутим..."
    ResultLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    RarityLabel.Text = ""
    BarFill.Size = UDim2.new(0, 0, 1, 0)
    SpinBtn.Text = "⏳ КРУТИТСЯ..."
    SpinBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 80)

    -- Анимация заполнения бара (имитация ожидания)
    local tween = TweenService:Create(BarFill, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(1, 0, 1, 0)
    })
    tween:Play()

    -- "Мигание" случайных фруктов
    local flickerCount = 0
    local flickerConn
    flickerConn = RunService.Heartbeat:Connect(function()
        flickerCount = flickerCount + 1
        if flickerCount % 5 == 0 then
            local randomFruit = FRUITS[math.random(1, #FRUITS)]
            ResultLabel.Text = randomFruit.name
            ResultLabel.TextColor3 = randomFruit.color
        end
    end)

    task.wait(1.4)
    flickerConn:Disconnect()

    -- Финальный результат
    local result = rollFruit()
    ResultLabel.Text = result.name
    ResultLabel.TextColor3 = result.color
    RarityLabel.Text = "Редкость: " .. result.rarity .. "  |  Шанс: " .. string.format("%.3f%%", result.chance)

    -- Эффект свечения для редких
    if result.rarity == "Mythical" then
        ResultFrame.BackgroundColor3 = Color3.fromRGB(60, 20, 40)
        local glow = Instance.new("UIStroke")
        glow.Color = result.color
        glow.Thickness = 2
        glow.Parent = ResultFrame
        task.delay(2, function() if glow then glow:Destroy() end end)
    elseif result.rarity == "Legendary" then
        ResultFrame.BackgroundColor3 = Color3.fromRGB(50, 45, 25)
    else
        ResultFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 50)
    end

    -- История
    table.insert(history, 1, result.name .. " (" .. result.rarity .. ")")
    if #history > 5 then table.remove(history) end
    HistoryLabel.Text = "Последние: " .. table.concat(history, ", ")

    -- Возврат кнопки
    SpinBtn.Text = "🎰 КРУТИТЬ"
    SpinBtn.BackgroundColor3 = Color3.fromRGB(80, 120, 200)
    spinning = false

    if callback then callback(result) end
end

SpinBtn.MouseButton1Click:Connect(function()
